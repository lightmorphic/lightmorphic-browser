#!/usr/bin/env bash
# Native-messaging host for LMB. Handles two things the extension sandbox
# can't do itself:
#   {"action":"install","new":"<path>"}  -> swap the AppImage + restart
#   {"action":"set-theme","mode":"light|dark"} -> record the browser theme
#                                                  mode + restart (so the
#                                                  whole browser chrome,
#                                                  not just the sidebar,
#                                                  changes light/dark)
# Restart = SIGTERM the browser (clean, tabs restored by "continue where
# you left off") + a detached relauncher that waits for it to exit then
# starts the (new / re-themed) binary.
#
# Pure bash + coreutils only -- no python/node assumed on the user's box.
set -euo pipefail

USER_DATA_DIR="${HOME}/.config/lightmorphic-browser"
LOG="${USER_DATA_DIR}/updater.log"
mkdir -p "$USER_DATA_DIR"
exec 2>>"$LOG"
echo "=== host invoked $(date -u +%FT%TZ) ===" >&2

# --- read one native message: 4-byte LE length, then that many bytes ---
len_raw=$(dd bs=1 count=4 2>/dev/null | od -An -tu1)
[ -n "$len_raw" ] || { echo "no length header" >&2; exit 0; }
len=$(echo "$len_raw" | awk '{print $1 + $2*256 + $3*65536 + $4*16777216}')
msg=$(dd bs=1 count="$len" 2>/dev/null)
echo "message: $msg" >&2

field() { printf '%s' "$msg" | sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'; }
action=$(field action)
echo "action: $action" >&2

target=""
if [ -f "${USER_DATA_DIR}/appimage-path" ]; then
  target=$(cat "${USER_DATA_DIR}/appimage-path")
fi
[ -z "$target" ] && target="${APPIMAGE:-}"

# --- ack so the extension knows we started ---
reply='{"status":"ok"}'
rlen=${#reply}
printf "$(printf '\\x%02x\\x%02x\\x%02x\\x%02x' \
  $((rlen & 255)) $(((rlen>>8) & 255)) $(((rlen>>16) & 255)) $(((rlen>>24) & 255)))"
printf '%s' "$reply"

restart_browser() {
  [ -z "$target" ] && { echo "no target to relaunch" >&2; return; }
  # detached relauncher: wait for this browser to exit, then start it
  setsid bash -c '
    t="'"$target"'"
    for _ in $(seq 1 120); do
      pgrep -f "$t" >/dev/null 2>&1 || break
      sleep 0.5
    done
    exec "$t"
  ' </dev/null >/dev/null 2>&1 &
  # ask the browser to quit (the no --type= chrome process = browser)
  for pid in $(pgrep -f "chromium/chrome" 2>/dev/null || true); do
    if [ -r "/proc/$pid/cmdline" ] && ! tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -- '--type='; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done
}

case "$action" in
  install)
    new_path=$(field new)
    echo "new_path: $new_path target: $target" >&2
    if [ -z "$new_path" ] || [ ! -f "$new_path" ] || [ -z "$target" ]; then
      echo "missing new_path or target -- aborting" >&2; exit 0
    fi
    tmp="${target}.new-$$"
    cp -f "$new_path" "$tmp"; chmod +x "$tmp"; mv -f "$tmp" "$target"
    echo "swapped $target" >&2
    restart_browser
    ;;
  set-theme)
    mode=$(field mode)
    [ "$mode" = "light" ] || mode="dark"
    printf '%s' "$mode" > "${USER_DATA_DIR}/theme-mode"
    echo "theme-mode set to $mode" >&2
    restart_browser
    ;;
  *)
    echo "unknown action" >&2
    ;;
esac
exit 0
