{
  "manifest_version": 3,
  "name": "Lightmorphic Browser Core",
  "version": "0.1.0",
  "description": "Sidebar, quick-paste, and end-to-end encrypted sync for Lightmorphic Browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Lightmorphic Browser"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "alarms",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contextmenu/clipboard-watch.js"],
      "run_at": "document_start"
    }
  ]
}
